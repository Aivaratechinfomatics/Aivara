# ===========================================================================
# Aivara Insight Lite — Environment Configuration Reference
# ===========================================================================

# Application Environment Mode (dev, staging, prod)
AIVARA_ENV=prod

# OpenRouter LLM API Configuration
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AIVARA_MODEL=openrouter/auto
AIVARA_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct:free

# LLM Daily Call Budget & Limits
AIVARA_DAILY_BUDGET=30
AIVARA_MAX_OUTPUT_TOKENS=150
AIVARA_SESSION_BUDGET=20
AIVARA_LLM_TIMEOUT=15.0

# Privacy & Security (Decision D2 & D5)
AIVARA_AUTH_REQUIRED=false
AIVARA_AUTH_HEADER_USER=X-Forwarded-User
AIVARA_SHARED_SECRET=
AIVARA_LLM_REDACT_LABELS=true
AIVARA_ALLOWED_LLM_HOSTS=openrouter.ai
AIVARA_ALLOW_INSECURE_LLM_HOSTS=false

# Cache & State Persistence (SQLite WAL Stores)
AIVARA_CACHE_ENABLED=true
AIVARA_CACHE_TTL_DAYS=7
AIVARA_CACHE_MAX_ENTRIES=1000
AIVARA_BUDGET_DB_PATH=.aivara_budget.db
AIVARA_CACHE_DB_PATH=.aivara_cache.db

# Ingestion Upload Limits
AIVARA_MAX_UPLOAD_MB=100
AIVARA_MAX_COLUMNS=500

# Export & Graphics Rendering
AIVARA_KALEIDO_TIMEOUT=15.0
